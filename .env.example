# ============================================================
# LlamaGuard Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# ------------------------------------------------------------
# HuggingFace
# ------------------------------------------------------------
# Required only if using a private HuggingFace model.
# Get your token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# 모델 경로 설정 (기본값: HuggingFace Hub에서 자동 로드)
# - Hub 사용 (기본): 주석 유지
# - 로컬 사용: llama_download.py 실행 후 아래 경로로 설정
# MODEL_PATH=cycloevan/vuln_detector   ← Hub
# MODEL_PATH=models/vuln_detector      ← 로컬 (llama_download.py 저장 위치)

# ------------------------------------------------------------
# Upstage API  (required for high-severity report generation)
# ------------------------------------------------------------
# Get your key at: https://console.upstage.ai
UPSTAGE_API_KEY=

# Optional overrides (defaults shown)
# UPSTAGE_BASE_URL=https://api.upstage.ai/v1
# UPSTAGE_MODEL=solar-pro2
